# 이 파일을 복사해서 local.properties로 만들고 실제 값 입력
# local.properties는 git에 올라가지 않음

sdk.dir=C:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk

# 카카오 디벨로퍼 콘솔에서 발급
KAKAO_NATIVE_APP_KEY=여기에_카카오_네이티브_앱_키
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키

# Firebase Console > 프로젝트 설정 > 일반 > 웹 SDK 구성 (Web client ID)
# 또는 google-services.json의 oauth_client web 항목
GOOGLE_WEB_CLIENT_ID=여기에_Google_OAuth_웹_클라이언트_ID.apps.googleusercontent.com
